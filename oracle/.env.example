# ── Filecoin Calibration testnet ──────────────────────────────────────────────
# Fund at: https://faucet.calibration.fildev.network/
CALIBRATION_PRIVATE_KEY=0x...

# USDFC for Synapse storage payments
# Fund at: https://forest-explorer.chainsafe.dev/faucet/calibnet_usdfc
# USDFC is auto-handled by Synapse SDK prepare() — just fund the wallet

# OracleAgentRegistry deployed address (set after running deploy-oracle-registry.ts)
ORACLE_REGISTRY_ADDRESS=0x...

# ── Ethereum Sepolia — ERC-8004 ────────────────────────────────────────────────
# Same key as Calibration or a separate one for ERC-8004 registrations
SEPOLIA_PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ERC-8004 registry addresses (deployed, do not change)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# ── Storacha ───────────────────────────────────────────────────────────────────
# Create a space at https://console.storacha.network/
# Generate key: npx @storacha/cli@latest key create
# Use your oracle DID as audience:
#   npx @storacha/cli@latest delegation create <did:key:...> \
#     --can 'store/add' --can 'upload/add' --can 'space/blob/add' \
#     --can 'space/index/add' --can 'filecoin/offer' --base64
STORACHA_PRINCIPAL_KEY=MgCaAA...
STORACHA_PROOF=mAYI...
# Optional alternative to avoid very long .env lines:
# STORACHA_PROOF_FILE=./storacha-proof.txt
# Optional fallback mode when delegations already exist in local client store:
# STORACHA_SPACE_DID=did:key:z6Mk...

# ── Oracle service ─────────────────────────────────────────────────────────────
PORT=8080
# Number of active agents to run per resolution (1-7)
ACTIVE_ORACLE_AGENTS=4
# Optional: Redis URL for persistent canonical betTxHash storage
# (used by /oracle/bets/register and /oracle/settle hash resolution fallback)
# ORACLE_REDIS_URL=redis://localhost:6379

# ── Flow EVM — settlement delivery ────────────────────────────────────────────
FLOW_RPC_URL=https://testnet.evm.nodes.onflow.org
GHOST_VAULT_ADDRESS=0xAf470490b2462DC7359605B8e5D731CbB7816B55

# Key used to sign settlement messages in the deployer-key fallback path.
# For testnet demos: set to the same key as CALIBRATION_PRIVATE_KEY or DEPLOYER_PRIVATE_KEY.
# This must match GhostVault.settlementSigner (set via contracts/scripts/update-settlement-signer.ts).
SETTLEMENT_SIGNER_PRIVATE_KEY=0x...

# GhostEAMM on Sepolia — needed by settlement module to read market outcome + pool totals
GHOST_EAMM_ADDRESS=0x...

# ── Lit Protocol V1 (Naga) — production settlement signing ────────────────────
# GhostMarket uses the Lit Protocol V1 (Naga) SDK for the Lit Protocol bounty.
# PKPs on Naga Dev are minted programmatically via the SDK (the explorer UI at
# explorer.litprotocol.com only shows Datil networks — ignore it).
#
# Full setup (3 commands):
#   1. npm run lit:pin    → pins lit-action.js to IPFS, prints LIT_ACTION_IPFS_CID
#   2. npm run lit:setup  → mints PKP + adds permitted action, prints LIT_PKP_* vars
#   3. cd contracts && npx ts-node scripts/update-settlement-signer.ts
#
# Then start the oracle: npm run dev  (auto-selects Lit path when vars are set)
#
# Network: nagaDev (free, centralized). Do NOT set LIT_NETWORK — it's an imported
# object from @lit-protocol/networks, not a string env var.

# Pinata JWT for pinning lit-action.js to IPFS (free at https://app.pinata.cloud)
PINATA_JWT=

# EOA private key authorised to execute Lit Actions on the PKP.
# Falls back to CALIBRATION_PRIVATE_KEY if not set.
LIT_AUTH_PRIVATE_KEY=

# The PKP's compressed secp256k1 public key (0x02... or 0x03...)
LIT_PKP_PUBLIC_KEY=

# The Ethereum address derived from the PKP public key (must == GhostVault.settlementSigner)
LIT_PKP_ETH_ADDRESS=

# IPFS CID of the uploaded Lit Action JS (oracle/src/lit-action.js)
LIT_ACTION_IPFS_CID=

# Optional: path for Lit session key caching (default: ./lit-auth-storage)
# LIT_STORAGE_PATH=./lit-auth-storage

# Lit Action execution mode:
# - safe   (default): node computes checks/payout, Lit Action signs only
# - strict: Lit Action re-checks market resolved + betTxHash log + locked collateral before signing
# Note: strict mode requires a valid betTxHash (request body or registered canonical hash).
# LIT_ACTION_MODE=safe

# Settlement signature mode:
# - eip191 (default): compatible with current deployed GhostVault.claimPayout
# - eip712: for upgraded GhostVault with claimPayoutFor relayer path
# SETTLEMENT_SIGNATURE_MODE=eip191

# Optional: how many blocks back to search for BetPlaced events (default: 500000 ≈ 69 days on Sepolia).
# Increase if you need to settle markets older than ~69 days.
# MARKET_LOOKBACK_BLOCKS=500000
# Optional: eth_getLogs scan chunk size for free-tier RPC compatibility (default: 10).
# BET_LOG_SCAN_CHUNK_SIZE=10