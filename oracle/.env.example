# ── Minimal env for `npm run dev` (oracle/src) ─────────────────────────────────
# Load order: `import 'dotenv/config'` in src/index.ts runs before other imports.

SEPOLIA_PRIVATE_KEY=0x...
# Must match GhostEAMM.resolver() for sealed-window pool userDecrypt (defaults to SEPOLIA_PRIVATE_KEY if unset):
# EAMM_RESOLVER_PRIVATE_KEY=0x...
# Optional aliases (same EOA as above); first non-empty wins in getSepoliaOraclePrivateKey():
# ORACLE_PRIVATE_KEY=0x...
# SETTLEMENT_SIGNER_PRIVATE_KEY=0x...

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

GHOST_EAMM_ADDRESS=0x...
GHOST_VAULT_ADDRESS=0x...

# EIP-712 domain version for settlement signatures — `2` for GhostVaultV2, `1` for legacy GhostVault.
GHOST_VAULT_EIP712_VERSION=2

# Optional — not read by the HTTP server; useful for scripts / humans.
# GHOST_MARKET_ADDRESS=0x...

PORT=8080
ACTIVE_ORACLE_AGENTS=4

OPENAI_API_KEY=
ORACLE_REASONING_MODEL=gpt-4o-mini
ORACLE_REASONING_TIMEOUT_MS=9000

# Sealed-window auto-settlement (optional)
# WINDOW_POLL_MS=10000
# WATCHED_MARKETS=1,2,3

# ── Optional: older tooling under oracle/scripts/ ────────────────────────────
# Calibration Filecoin, Storacha, ERC-8004 registry, Lit/Pinata, Flow, Redis,
# Cadence adapter, etc. are not loaded by the main server. Add those only if
# you run the corresponding deploy/register scripts.
