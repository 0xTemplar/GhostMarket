# ── Filecoin Calibration testnet ──────────────────────────────────────────────
# Fund at: https://faucet.calibration.fildev.network/
CALIBRATION_PRIVATE_KEY=0x...

# USDFC for Synapse storage payments
# Fund at: https://forest-explorer.chainsafe.dev/faucet/calibnet_usdfc
# USDFC is auto-handled by Synapse SDK prepare() — just fund the wallet

# OracleAgentRegistry deployed address (set after running deploy-oracle-registry.ts)
ORACLE_REGISTRY_ADDRESS=0x...

# ── Ethereum Sepolia — ERC-8004 ────────────────────────────────────────────────
# Same key as Calibration or a separate one for ERC-8004 registrations
SEPOLIA_PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ERC-8004 registry addresses (deployed, do not change)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# ── Storacha ───────────────────────────────────────────────────────────────────
# Create a space at https://console.storacha.network/
# Generate key: npx @storacha/cli@latest key create
# Use your oracle DID as audience:
#   npx @storacha/cli@latest delegation create <did:key:...> \
#     --can 'store/add' --can 'upload/add' --can 'space/blob/add' \
#     --can 'space/index/add' --can 'filecoin/offer' --base64
STORACHA_PRINCIPAL_KEY=MgCaAA...
STORACHA_PROOF=mAYI...
# Optional alternative to avoid very long .env lines:
# STORACHA_PROOF_FILE=./storacha-proof.txt
# Optional fallback mode when delegations already exist in local client store:
# STORACHA_SPACE_DID=did:key:z6Mk...

# ── Oracle service ─────────────────────────────────────────────────────────────
PORT=8080
# Number of active agents to run per resolution (1-7)
ACTIVE_ORACLE_AGENTS=4

# ── Flow EVM — settlement delivery ────────────────────────────────────────────
FLOW_RPC_URL=https://testnet.evm.nodes.onflow.org
GHOST_VAULT_ADDRESS=0xAf470490b2462DC7359605B8e5D731CbB7816B55
SETTLEMENT_SIGNER_PRIVATE_KEY=0x...