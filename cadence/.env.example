# ── Cadence Adapter ────────────────────────────────────────────────────────────

# Port for the HTTP microservice (oracle calls this)
CADENCE_ADAPTER_PORT=8093

# ── Flow Cadence account (oracle's Cadence identity) ──────────────────────────
# Generate with: flow keys generate --sig-algo ECDSA_secp256k1
# Fund with testnet FLOW via: https://testnet-faucet.onflow.org
CADENCE_ACCOUNT_ADDRESS=0x...
CADENCE_PRIVATE_KEY=...        # secp256k1 private key, no 0x prefix
CADENCE_KEY_INDEX=0            # key index on the account (default 0)

# ── Flow network ───────────────────────────────────────────────────────────────
FLOW_NETWORK=testnet
FLOW_ACCESS_NODE=https://rest-testnet.onflow.org
FLOW_RPC_URL=https://testnet.evm.nodes.onflow.org

# ── GhostMarket contracts (Flow EVM) ──────────────────────────────────────────
GHOST_VAULT_ADDRESS=0x377688cf84caaD124d5Ee99671323729D76C186f
GHOST_MARKET_ADDRESS=0x7D26f77c698C9277b9eBaB47E3b73CF08853d76a

# ── GhostVaultResolverHandler Cadence contract ────────────────────────────────
# Set after deploying contracts/GhostVaultResolverHandler.cdc
# Run: flow project deploy --network testnet
CADENCE_HANDLER_CONTRACT_ADDRESS=0x...

# ── Scheduling fees ────────────────────────────────────────────────────────────
# FLOW tokens paid upfront to the scheduler. Medium priority ~0.005–0.05 FLOW.
# The oracle Cadence account must hold enough FLOW for all scheduled markets.
CADENCE_SCHEDULER_FEE_FLOW=0.11

# ── Flow testnet contract addresses (defaults correct for testnet) ─────────────
# Change only if you're targeting a different network.
FLOW_TRANSACTION_SCHEDULER_ADDR=0x8c5303eaa26202d6
FLOW_TOKEN_ADDR=0x7e60df042a9c0868
FUNGIBLE_TOKEN_ADDR=0x9a0766d93b6608b7
