# ─── Flow EVM (GhostVault + GhostMarket) ──────────────────────────────────────
# Private key of the deployer wallet (Flow EVM testnet)
# Fund it from https://faucet.flow.com (request test FLOW to the EVM address)
DEPLOYER_PRIVATE_KEY=

# Address whose key the Lit Action / backend will use to sign payout attestations
# Can be the deployer address for testnet. Replace with a dedicated key for mainnet.
SETTLEMENT_SIGNER_ADDRESS=

# Deployed GhostMarket contract address (set after running deploy-market script)
GHOST_MARKET_ADDRESS=

# Sepolia — deploy stack (see scripts/deploy-sepolia.ts)
# USE_ZAMA_SEPOLIA_MOCK_USDC=1 (default if unset) uses Zama’s canonical mock underlying
#   https://docs.zama.org/protocol/protocol-apps/addresses/testnet/sepolia
# Set to 0 to deploy a fresh repo MockUSDC.sol instead (isolated test addresses).
# USE_ZAMA_SEPOLIA_MOCK_USDC=1
# Zama Protocol runs ON Ethereum Sepolia, not a standalone chain.
# Docs: https://docs.zama.org/protocol/solidity-guides/development-guide/hardhat

# Sepolia deployer private key (can differ from DEPLOYER_PRIVATE_KEY)
# Fund from https://sepoliafaucet.com or https://www.alchemy.com/faucets/ethereum-sepolia
SEPOLIA_PRIVATE_KEY=

# Sepolia RPC URL — use Alchemy or Infura for reliability
# Public fallback: https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Zama Sepolia contract addresses (for reference — baked into ZamaEthereumConfig automatically)
# Source: https://docs.zama.org/protocol/solidity-guides/smart-contract/configure/contract_addresses
# ACL_CONTRACT            = 0xf0Ffdc93b7E186bC2f8CB3dAA75D86d1930A433D
# KMS_VERIFIER_CONTRACT   = 0xbE0E383937d564D7FF0BC3b46c51f0bF8d5C311A
# RELAYER_URL             = https://relayer.testnet.zama.org

# Address of the market manager (mirrors GhostMarket.sol owner — deployer is fine for testnet)
MARKET_MANAGER_ADDRESS=

# Address of the resolver (becomes oracle multi-sig in Phase 5 — use deployer for now)
RESOLVER_ADDRESS=

# Deployed GhostEAMM address on Sepolia (set after: npx hardhat run scripts/deploy-eamm.ts --network sepolia)
GHOST_EAMM_ADDRESS=
